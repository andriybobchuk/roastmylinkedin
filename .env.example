# Required: Apify token (free tier gives $5/mo credit — enough for ~1000 profile scrapes)
# Get one at: https://console.apify.com/settings/integrations
APIFY_TOKEN=apify_api_YOUR_TOKEN_HERE

# Required: at least ONE LLM key.

# Option A — Gemini (free tier at aistudio.google.com):
GEMINI_API_KEY=AQ.Ab8_YOUR_TOKEN_HERE
# GEMINI_MODEL=gemini-3.6-flash   # optional override

# Option B — Anthropic Claude (paid, ~$0.02/audit):
# ANTHROPIC_API_KEY=sk-ant-YOUR_KEY_HERE
